# MODELO — NÃO GRAVAR SEGREDOS REAIS NO GITHUB

# Orquestração
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_SECRET=replace_in_secret_manager

# Criação de conteúdo
DIFY_BASE_URL=https://dify.example.com
DIFY_API_KEY=replace_in_secret_manager

# Publicação multicanal
POSTIZ_BASE_URL=https://postiz.example.com
POSTIZ_API_KEY=replace_in_secret_manager

# Meta — manter em cofre de segredos
FACEBOOK_APP_ID=replace_in_secret_manager
FACEBOOK_APP_SECRET=replace_in_secret_manager

# TikTok — somente após configuração e auditoria aplicáveis
TIKTOK_CLIENT_ID=replace_in_secret_manager
TIKTOK_CLIENT_SECRET=replace_in_secret_manager

# Segurança operacional
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR
PUBLISHING_MODE=draft
MAX_POSTS_PER_DAY=2
REQUIRE_APPROVAL=true
